# Application
DEFAULT_ADMIN_FIRST_NAME=Arash
DEFAULT_ADMIN_LAST_NAME=Goharrostami
DEFAULT_ADMIN_EMAIL=admin@zexserver.com
DEFAULT_ADMIN_PASSWORD=admin

# Comma-separated browser origins allowed to call the API (no wildcard in production).
CORS_ORIGIN=https://zexserver.com,https://www.zexserver.com
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=zexserver
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=zexserver
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false

# RedisDB
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAPI
OPENAPI_TITLE=ZexServer
OPENAPI_VERSION=1.0.0
OPENAPI_BASE_PATH=/api/v1
OPENAPI_SERVER_URL=https://api.zexserver.com/api/v1
OPENAPI_DESCRIPTION=ZexServer hosting platform API

# JWTToken
JWT_MIN_TIME=3600#1h
JWT_MAX_TIME=604800#7d
JWT_SECRET_KEY=set-a-real-secret-here
