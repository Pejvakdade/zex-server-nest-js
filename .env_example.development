# Application
DEFAULT_ADMIN_FIRST_NAME=Arash
DEFAULT_ADMIN_LAST_NAME=Goharrostami
DEFAULT_ADMIN_EMAIL=admin@zexserver.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Leave CORS_ORIGIN empty in development: any origin is accepted (ng serve on 4200).
CORS_ORIGIN=
# pino level; defaults to debug in development, info in production.
LOG_LEVEL=

# Postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USERNAME=zexserver
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=zexserver
POSTGRES_SYNCHRONIZE=true
POSTGRES_LOGGING=false

# RedisDB
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAPI
OPENAPI_TITLE=ZexServer
OPENAPI_VERSION=1.0.0
OPENAPI_BASE_PATH=/api/v1
OPENAPI_SERVER_URL=http://localhost:3000/api/v1
OPENAPI_DESCRIPTION=ZexServer hosting platform API

# JWTToken
JWT_MIN_TIME=3600#1h
JWT_MAX_TIME=604800#7d
JWT_SECRET_KEY=change-me-in-production-zexserver-dev-secret
